# Django
SECRET_KEY=replace-with-a-strong-random-secret

# Database (PostgreSQL)
DB_NAME=cpms
DB_USER=cpms
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# External API
GOOGLE_ROUTES_API_KEY=replace-with-google-routes-api-key

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_WORKER_CONCURRENCY=2

